}

/* Search suggestions dropdown */
.suggestions {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    z-index: 5;
    max-height: 200px;
    overflow-y: auto;
    margin-top: 4px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--r-sm);
    box-shadow: 0 8px 24px rgba(6, 26, 74, 0.14);
}
.suggestions:empty { display: none; }
.suggestions div {
    padding: 9px 12px;
    font-size: 0.9rem;
    cursor: pointer;
}
.suggestions div:hover,
.suggestions div.active {
    color: var(--logo-blue);
    background: #eaf1fc;
}

/* Day toggles: outlined when off, filled with an x when selected */
#dayButtons { display: flex; flex-wrap: wrap; gap: 8px; }
#dayButtons button {
    display: inline-flex;
    align-items: center;
    padding: 8px 12px 8px 14px;
    color: var(--logo-blue);
    background: var(--surface);
    border-color: var(--line);
}
#dayButtons button:hover { background: #eaf1fc; border-color: var(--steel); }
#dayButtons button.selected,
#dayButtons button.selected:hover {
    color: #fff;
    background: var(--logo-blue);
    border-color: var(--logo-blue);
}
.remove-day, .close-x {
    display: none;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    margin-left: 10px;
    font-size: 1rem;
    font-weight: 800;
    line-height: 1;
    color: #fff;
    background: rgba(255, 255, 255, 0.18);
    border: 1px solid rgba(255, 255, 255, 0.4);
    border-radius: 5px;
    transition: background 0.15s;
}
.remove-day:hover, .close-x:hover { background: rgba(255, 255, 255, 0.35); }
#dayButtons button.selected .remove-day { display: inline-flex; }

/* Shown instead of the dashboards for roles without one yet */
.notice {
    padding: 48px 24px;
    text-align: center;
    font-weight: 600;
    color: var(--muted);
    background: var(--surface);
    border: 1px dashed #b7c4dd;
    border-radius: 14px;
}

/* ---------- Tables ---------- */
table { width: 100%; border-collapse: collapse; font-size: 0.9rem; }


th {
    text-align: left;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--logo-blue);
    background: #eaf1fc;
    padding: 10px 14px;
    white-space: nowrap;
}
th:first-child { border-radius: var(--r-sm) 0 0 var(--r-sm); }
th:last-child  { border-radius: 0 var(--r-sm) var(--r-sm) 0; }

td {
    padding: 12px 14px;
    border-bottom: 1px solid var(--line);
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
}
td:first-child { font-weight: 600; }

/* Report tables: wider panels, tighter cells and wrapping text so more columns fit before scrolling */
#attendanceContainer, #studentAttendanceContainer { padding: 20px; }
.report-table { min-width: 880px; font-size: 0.86rem; }
.report-table th, .report-table td { padding: 10px; white-space: normal; }
.report-table th { vertical-align: bottom; }
#studentAttendanceFilters { grid-template-columns: repeat(auto-fit, minmax(190px, 260px)); }

.empty-row td,
.empty-row:hover td {
    padding: 32px 14px;
    text-align: center;
    font-weight: 500;
    color: var(--muted);
    background: transparent;
    white-space: normal;
}
#timetableTableBody td:nth-child(4) { text-transform: capitalize; }
td button {
    padding: 5px 12px;
    font-size: 0.8rem;
    color: var(--logo-blue);
    background: var(--surface);
    border-color: var(--line);
}
td button + button { margin-left: 6px; }
td button:hover { color: #fff; background: var(--logo-blue); border-color: var(--logo-blue); }
tbody tr:hover td { background: #f7faff; }
tbody tr:last-child td { border-bottom: 0; }

.filters {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
    gap: 14px 16px;
    align-items: end;
    margin-bottom: 20px;
    padding: 16px;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--r-md);
}
.filter-field { position: relative; min-width: 0; }
.filter-actions { display: flex; gap: 8px; }
#attendanceContainer, #studentAttendanceContainer { min-height: 360px; }


/* ---------- Badges ---------- */
.badge {
    display: inline-block;
    padding: 2px 10px;
    font-size: 0.78rem;
    font-weight: 700;
    border-radius: 999px;
    text-transform: capitalize;
}
.badge-success { color: var(--ok);   background: var(--ok-bg); }
.badge-warn    { color: var(--warn); background: var(--warn-bg); }
.badge-danger  { color: var(--bad);  background: var(--bad-bg); }
.badge-muted   { color: var(--muted); background: #e9edf5; }
.badge-role    { color: #fff; background: var(--electric); }
td .badge-role { color: var(--logo-blue); background: #dbe8fc; }
#roleBadge:empty { display: none; }

/* ---------- Small screens ---------- */
@media (max-width: 860px) {
    .login-container { display: block; }
    .brand-panel { display: none; }
    .login-card { margin: 0 auto; padding: 48px 0; }
    .login-card .form-logo { display: block; }
    .content { padding: 20px 16px; }
    .toast { top: 12px; right: 16px; left: 16px; max-width: none; }
    .topbar { padding: 12px 16px; flex-wrap: wrap; }
    #usersContainer, #createUserContainer, #timetableContainer, #attendanceContainer,
    #studentAttendanceContainer { padding: 16px; }
    #createTimetableContainer { padding: 16px; }
    #createTimetableForm { grid-template-columns: 1fr; }
}

@media (prefers-reduced-motion: reduce) {
    * { transition: none !important; animation: none !important; }
}

/* ---------- Phase 1: student dashboard ---------- */
.stat-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 14px;
    margin-bottom: 24px;
}
.stat {
    padding: 16px 18px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    box-shadow: var(--shadow);
}
.stat-value {
    font-size: 1.7rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.1;
    color: var(--logo-blue);
    font-variant-numeric: tabular-nums;
}
.stat-label { margin-top: 4px; font-size: 0.8rem; font-weight: 600; color: var(--muted); }

#studentSessionContainer {
    margin-bottom: 24px;
    padding: 28px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 14px;
    box-shadow: var(--shadow);
    animation: panel-in 0.22s ease-out;
}

.session-card {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto;
    align-items: center;
    gap: 16px 24px;
}
.session-title { font-size: 1.2rem; font-weight: 800; letter-spacing: -0.015em; }
.session-meta { margin-top: 2px; font-weight: 600; font-variant-numeric: tabular-nums; }
.session-note { margin-top: 6px; font-size: 0.9rem; color: var(--muted); }
.session-state { display: flex; gap: 6px; }
.session-actions { display: flex; flex-wrap: wrap; gap: 10px; }
.session-empty { margin-bottom: 12px; font-weight: 500; color: var(--muted); }
#currentSession > .session-empty:last-child { margin-bottom: 0; }

.btn-outline {
    color: var(--logo-blue);
    background: transparent;
    border-color: var(--line);
}
.btn-outline:hover {
    color: #fff;
    background: var(--logo-blue);
    border-color: var(--logo-blue);
}
/* disabled buttons shouldn't react to hover */
button:disabled:hover { background: var(--logo-blue); border-color: var(--logo-blue); }
.btn-outline:disabled:hover { color: var(--logo-blue); background: transparent; border-color: var(--line); }

@media (max-width: 860px) {
    #studentSessionContainer { padding: 16px; }
    .session-card { grid-template-columns: 1fr; }
    .session-actions button { flex: 1; }
}


/* ---------- Phase 2: classes + user management ---------- */
#classesContainer {
    display: none;
    margin-bottom: 24px;
    padding: 28px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 14px;
    box-shadow: var(--shadow);
    overflow-x: auto;
    animation: panel-in 0.22s ease-out;
}

/* a short form on one line: field + button */
.inline-form {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 12px;
    margin-bottom: 20px;
    padding: 16px;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--r-md);
}
.inline-form .form-group { flex: 1 1 260px; margin-bottom: 0; }
.inline-form > button[type="submit"] { width: auto; margin-top: 0; }

/* dropdowns that live inside table cells */
td select {
    min-width: 160px;
    padding: 6px 30px 6px 10px;
    font-size: 0.85rem;
    background-position: right 10px center;
}
td select.unassigned { border-color: #e2b34b; background-color: var(--warn-bg); }

@media (max-width: 860px) {
    #classesContainer { padding: 16px; }
}


/* ---------- Phase 3: sessions panel, dialog, report extras ---------- */
/* an author display rule must never defeat the hidden attribute */
[hidden] { display: none !important; }

#sessionsContainer {
    display: none;
    margin-bottom: 24px;
    padding: 20px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 14px;
    box-shadow: var(--shadow);
    overflow-x: auto;
    animation: panel-in 0.22s ease-out;
}
.panel-hint { margin: -6px 0 16px; color: var(--muted); font-size: 0.9rem; }
.sessions-table { min-width: 980px; }
.sessions-table td { vertical-align: top; }
.sessions-table td .badge { margin-left: 8px; }
.sessions-table td.details { min-width: 220px; font-size: 0.85rem; color: var(--muted); }
.sessions-table td:last-child { white-space: normal; }
.sessions-table td:last-child button { margin: 0 6px 6px 0; }
.sessions-table tr.today td { background: #f4f8ff; }
.sessions-table tr.replacement td:first-child { box-shadow: inset 3px 0 0 var(--steel); }

td button.btn-danger-outline { color: var(--bad); border-color: #f0c4c0; }
td button.btn-danger-outline:hover { color: #fff; background: var(--bad); border-color: var(--bad); }
.btn-danger, .btn-danger:hover { background: var(--bad); border-color: var(--bad); }
.btn-danger:hover { filter: brightness(0.92); }

.report-count { margin: -4px 0 12px; font-size: 0.85rem; font-weight: 600; color: var(--muted); }

/* modal dialog */
dialog#sessionDialog {
    width: min(460px, calc(100vw - 32px));
    padding: 28px;
    color: var(--ink);
    background: var(--surface);
    border: 1px solid var(--line);
    border-top: 5px solid var(--logo-blue);
    border-radius: var(--r-md);
    box-shadow: 0 24px 60px rgba(6, 26, 74, 0.3);
}
dialog#sessionDialog::backdrop { background: rgba(6, 26, 74, 0.45); }
#sessionDialog h3 { margin-bottom: 8px; }
.dialog-summary { margin-bottom: 18px; font-size: 0.9rem; color: var(--muted); }
.dialog-warning { margin-top: 6px; color: var(--warn); font-weight: 600; }
.check-row {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 14px;
    font-weight: 600;
    cursor: pointer;
}
.check-row input { width: auto; accent-color: var(--logo-blue); }
.field-pair { display: grid; grid-template-columns: 1fr 1fr; gap: 0 14px; }
#sessionDialogError { margin: 0 0 14px; padding: 10px 12px; font-size: 0.9rem; font-weight: 500; border-radius: 0 var(--r-sm) var(--r-sm) 0; }
#sessionDialogError:empty { display: none; }
.dialog-actions { display: flex; justify-content: flex-end; gap: 10px; margin-top: 6px; }

@media (max-width: 860px) {
    #sessionsContainer { padding: 16px; }
    dialog#sessionDialog { padding: 20px; }
}


/* ---------- Report paging ---------- */
.pager {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    margin-top: 16px;
}
.pager span { min-width: 110px; text-align: center; font-size: 0.9rem; font-weight: 600; color: var(--muted); }


/* ---------- Phase 4: instructor dashboard ---------- */
#instructorDashboard { display: none; }

#instructorScheduleContainer,
#instructorTimetablesContainer,
#instructorReportContainer {
    display: none;
    margin-bottom: 24px;
    padding: 20px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 14px;
    box-shadow: var(--shadow);
    overflow-x: auto;
    animation: panel-in 0.22s ease-out;
}

#instructorTimetablesBody td:nth-child(3) { text-transform: capitalize; }
.sessions-table .muted, .muted { color: var(--muted); font-size: 0.85rem; }

dialog#rosterDialog {
    width: min(680px, calc(100vw - 32px));
    max-height: calc(100vh - 48px);
    padding: 28px;
    color: var(--ink);
    background: var(--surface);
    border: 1px solid var(--line);
    border-top: 5px solid var(--logo-blue);
    border-radius: var(--r-md);
    box-shadow: 0 24px 60px rgba(6, 26, 74, 0.3);
}
dialog#rosterDialog::backdrop { background: rgba(6, 26, 74, 0.45); }
#rosterDialog h3 { margin-bottom: 8px; }
.roster-counts { margin-bottom: 14px; font-size: 0.9rem; font-weight: 700; color: var(--logo-blue); }
.roster-scroll { max-height: 50vh; overflow: auto; margin-bottom: 18px; border: 1px solid var(--line); border-radius: var(--r-sm); }
.roster-scroll table { min-width: 460px; }
#rosterError { margin: 0 0 14px; padding: 10px 12px; font-size: 0.9rem; font-weight: 500; border-radius: 0 var(--r-sm) var(--r-sm) 0; }
#rosterError:empty { display: none; }

@media (max-width: 860px) {
    #instructorScheduleContainer,
    #instructorTimetablesContainer,
    #instructorReportContainer { padding: 16px; }
    dialog#rosterDialog { padding: 20px; }
}


/* ---------- Phase 5: summaries, password dialog, states, small screens ---------- */
#summaryContainer,
#instructorSummaryContainer {
    display: none;
    margin-bottom: 24px;
    padding: 20px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 14px;
    box-shadow: var(--shadow);
    overflow-x: auto;
    animation: panel-in 0.22s ease-out;
}

/* attendance-rate tiles on the student dashboard */
.stat-success .stat-value { color: var(--ok); }
.stat-warn .stat-value { color: var(--warn); }
.stat-danger .stat-value { color: var(--bad); }

#studentCourseSummary {
    margin-bottom: 24px;
    padding: 20px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 14px;
    box-shadow: var(--shadow);
}
#studentCourseSummary:empty { display: none; }
.table-scroll { overflow-x: auto; }
#studentCourseSummary .report-table { min-width: 520px; }

/* loading and failed table states */
tr.loading td { color: var(--muted); font-style: italic; }
tr.error-row td { color: var(--bad); background: var(--bad-bg); }

/* top bar: change password sits beside log out */
#changePasswordButton {
    background: transparent;
    border-color: rgba(255, 255, 255, 0.4);
    padding: 7px 14px;
}
#changePasswordButton:hover { background: #fff; border-color: #fff; color: var(--navy); }

dialog#passwordDialog {
    width: min(420px, calc(100vw - 32px));
    padding: 28px;
    color: var(--ink);
    background: var(--surface);
    border: 1px solid var(--line);
    border-top: 5px solid var(--logo-blue);
    border-radius: var(--r-md);
    box-shadow: 0 24px 60px rgba(6, 26, 74, 0.3);
}
dialog#passwordDialog::backdrop { background: rgba(6, 26, 74, 0.45); }
#passwordDialog h3 { margin-bottom: 18px; }
#passwordError { margin: 0 0 14px; padding: 10px 12px; font-size: 0.9rem; font-weight: 500; border-radius: 0 var(--r-sm) var(--r-sm) 0; }
#passwordError:empty { display: none; }
.field-hint { display: block; margin-top: 5px; font-size: 0.8rem; color: var(--muted); }

/* keyboard users can jump past the header */
.skip-link {
    position: absolute;
    left: 12px;
    top: -60px;
    z-index: 2000;
    padding: 10px 16px;
    font-weight: 700;
    color: #fff;
    background: var(--logo-blue);
    border-radius: var(--r-sm);
}
.skip-link:focus { top: 12px; }
main:focus { outline: none; }

@media (max-width: 860px) {
    #summaryContainer, #instructorSummaryContainer, #studentCourseSummary { padding: 16px; }
    .topbar-user { width: 100%; margin-left: 0; flex-wrap: wrap; }
    dialog#passwordDialog { padding: 20px; }
    .admin-actions { width: 100%; }
    .admin-actions button { flex: 1 1 auto; }
}

/* fingers need bigger targets than mouse pointers */
@media (pointer: coarse) {
    button { min-height: 44px; }
    td button { min-height: 40px; }
    input, select { min-height: 44px; }
    input[type="checkbox"] { min-height: 0; }
}


/* ---------- Phase 6: notifications bell + missed-sessions drill-down ---------- */
.sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
}

/* a button that reads as a link (used for student names and "Mark all read") */
.link-button,
td button.link-button,
td button.link-button:hover,
.link-button:hover {
    padding: 0;
    font: inherit;
    font-weight: 600;
    color: var(--logo-blue);
    background: none;
    border: 0;
    text-align: left;
    text-decoration: underline;
    text-underline-offset: 3px;
}
.link-button:hover, td button.link-button:hover { color: var(--electric); }
.link-button:disabled { opacity: 0.45; cursor: default; text-decoration: none; }

.notifications { position: relative; }

.icon-button {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    padding: 0;
    color: #fff;
    background: transparent;
    border-color: rgba(255, 255, 255, 0.4);
    border-radius: 50%;
}
.icon-button:hover { color: var(--navy); background: #fff; border-color: #fff; }

.notification-count {
    position: absolute;
    top: -6px;
    right: -6px;
    min-width: 20px;
    padding: 1px 5px;
    font-size: 0.7rem;
    font-weight: 800;
    line-height: 1.5;
    text-align: center;
    color: #fff;
    background: var(--bad);
    border: 2px solid var(--navy);
    border-radius: 999px;
}

.notifications-panel {
    position: absolute;
    right: 0;
    top: calc(100% + 12px);
    z-index: 900;
    width: min(380px, calc(100vw - 24px));
    max-height: min(520px, 75vh);
    overflow-y: auto;
    padding: 6px 0 12px;
    color: var(--ink);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    box-shadow: 0 16px 40px rgba(6, 26, 74, 0.22);
}
.notifications-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 10px 16px;
    border-bottom: 1px solid var(--line);
}
.notifications-status { padding: 14px 16px; font-size: 0.9rem; color: var(--muted); }
.notifications-status:empty { display: none; }
.notifications-list { list-style: none; }

.notifications-list .notification-item {
    display: block;
    width: 100%;
    padding: 12px 16px;
    font-weight: 400;
    text-align: left;
    color: var(--ink);
    background: transparent;
    border: 0;
    border-bottom: 1px solid var(--line);
    border-radius: 0;
}
.notifications-list .notification-item:hover { background: #f4f8ff; border-color: var(--line); }
.notifications-list .notification-item.unread { background: #eef5ff; box-shadow: inset 4px 0 0 var(--electric); }
.notifications-list .notification-item.unread:hover { background: #e3eeff; }
.notification-title, .notification-message, .notification-time { display: block; }
.notification-title { font-size: 0.92rem; }
.notification-message { margin-top: 3px; font-size: 0.85rem; color: var(--ink); }
.notification-time { margin-top: 5px; font-size: 0.75rem; color: var(--muted); }
#notificationsMore { display: block; margin: 12px auto 0; }

dialog#missedDialog {
    width: min(720px, calc(100vw - 32px));
    max-height: calc(100vh - 48px);
    padding: 28px;
    color: var(--ink);
    background: var(--surface);
    border: 1px solid var(--line);
    border-top: 5px solid var(--logo-blue);
    border-radius: var(--r-md);
    box-shadow: 0 24px 60px rgba(6, 26, 74, 0.3);
}
dialog#missedDialog::backdrop { background: rgba(6, 26, 74, 0.45); }
#missedDialog h3 { margin-bottom: 8px; }
#missedDialog .roster-scroll table { min-width: 520px; }
#missedDialog td { white-space: normal; }
#missedDialog .muted { margin-top: 4px; }

@media (max-width: 860px) {
    /* the panel can't hang off a button in the middle of a wrapped top bar */
    .notifications { position: static; }
    .notifications-panel { position: fixed; left: 12px; right: 12px; top: 70px; width: auto; }
    dialog#missedDialog { padding: 20px; }
}
