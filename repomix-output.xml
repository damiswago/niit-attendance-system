<file path="frontend/js/timetable.js">
// Admin: timetable list, activate/deactivate, create and edit.
// Needs: common.js (NIIT helpers) loaded first.
document.addEventListener("DOMContentLoaded", () => {
  if (!document.getElementById("timetableContainer")) {
    return;
  }

  const {
    api,
    showToast,
    withBusy,
    createAutocomplete,
    showPanel,
    makeCell,
    emptyRow,
    loadingRow,
    errorRow,
    getClasses,
    fillSelect,
  } = NIIT;
  const byId = (id) => document.getElementById(id);

  // ---------- DOM ----------
  const manageButton = byId("manageTimetableButton");
  const tableBody = byId("timetableTableBody");
  const toggleButton = byId("createTimetableButton");
  const formPanel = byId("createTimetableContainer");
  const formTitle = byId("timetableFormTitle");
  const form = byId("createTimetableForm");
  const submitButton = byId("submitTimetableButton");
  const courseInput = byId("timetableCourse");
  const instructorInput = byId("timetableInstructor");
  const startInput = byId("timetableStartTime");
  const endInput = byId("timetableEndTime");
  const fromInput = byId("effectiveFrom");
  const untilInput = byId("effectiveUntil");
  const classSelect = byId("timetableClass");
  const dayButtons = document.querySelectorAll("#dayButtons button");

  // ---------- State ----------
  const state = {
    timetables: [],
    instructors: [],
    classes: [],
    selectedDays: [],
    editingId: null,
  };

  // ---------- Autocomplete ----------
  const courseSearch = createAutocomplete({
    input: courseInput,
    list: byId("courseSuggestions"),
    getItems: () => [...new Set(state.timetables.map((t) => t.course))],
  });

  const instructorSearch = createAutocomplete({
    input: instructorInput,
    list: byId("instructorSuggestions"),
    getItems: () => state.instructors,
    getLabel: (instructor) => instructor.name,
    // typing invalidates the previously chosen instructor
    onType: () => {
      instructorInput.dataset.instructorId = "";
    },
    onSelect: (instructor) => {
      instructorInput.dataset.instructorId = instructor._id;
    },
  });

  // ---------- Helpers ----------
  const idOf = (ref) => (ref && ref._id) || ref;

  const toDateInput = (value) => {
    const date = new Date(value);

    return value && !isNaN(date) ? date.toISOString().slice(0, 10) : "";
  };

  const syncDayButtons = () => {
    dayButtons.forEach((button) => {
      button.classList.toggle(
        "selected",
        state.selectedDays.includes(button.dataset.day),
      );
    });
  };

  const setFormOpen = (open) => {
    formPanel.style.display = open ? "block" : "none";
    toggleButton.setAttribute("aria-expanded", String(open));
  };

  const resetForm = () => {
    state.editingId = null;
    state.selectedDays = [];

    form.reset();
    instructorInput.dataset.instructorId = "";
    courseSearch.close();
    instructorSearch.close();

    formTitle.textContent = "Create Timetable";
    submitButton.textContent = "Create Timetable";

    syncDayButtons();
  };

  const readForm = () => {
    const data = {
      course: courseInput.value.trim(),
      class: classSelect.value,
      instructor: instructorInput.dataset.instructorId || "",
      daysOfWeek: [...state.selectedDays],
      startTime: startInput.value,
      endTime: endInput.value,
      effectiveFrom: fromInput.value,
      effectiveUntil: untilInput.value || null,
    };

    if (
      !data.course ||
      !data.class ||
      !data.daysOfWeek.length ||
      !data.startTime ||
      !data.endTime ||
      !data.effectiveFrom
    ) {
      return { error: "Please complete all required fields" };
    }

    if (!data.instructor) {
      return { error: "Please choose an instructor from the suggestions" };
    }

    if (data.endTime <= data.startTime) {
      return { error: "End time must be after the start time" };
    }

    if (data.effectiveUntil && data.effectiveUntil < data.effectiveFrom) {
      return { error: "Effective Until can't be before Effective From" };
    }

    return { data };
  };

  const makeButton = (label, onClick) => {
    const button = document.createElement("button");

    button.type = "button";
    button.textContent = label;
    button.addEventListener("click", () => withBusy(button, onClick));

    return button;
  };

  // ---------- Data ----------
  const loadTimetables = async () => {
    tableBody.replaceChildren(loadingRow(8));

    const res = await api("/timetable");

    if (!res.ok) {
      const message = res.data.message || "Could not load timetables";

      showToast(message, "error");
      tableBody.replaceChildren(errorRow(8, message));
      return;
    }

    state.timetables = res.data.timetables || [];
    renderTimetables();
  };

  const loadInstructors = async () => {
    const res = await api("/users");

    if (!res.ok) {
      showToast(res.data.message || "Could not load instructors", "error");
      return;
    }

    state.instructors = (res.data.users || []).filter(
      (user) => user.role === "instructor" && user.status === "active",
    );
  };

  const loadClasses = async () => {
    const { classes, error } = await getClasses();

    if (error) {
      showToast(error, "error");
    }

    state.classes = classes;

    fillSelect(classSelect, state.classes, {
      placeholder: state.classes.length
        ? "Select class"
        : "No classes yet - add one first",
      selected: classSelect.value,
    });
  };

  // ---------- Render ----------
  const renderTimetables = () => {
    tableBody.innerHTML = "";

    if (!state.timetables.length) {
      tableBody.appendChild(emptyRow(8, "No timetables yet."));
      return;
    }

    state.timetables.forEach((timetable) => {
      const row = document.createElement("tr");
      const actionsCell = makeCell("");

      actionsCell.appendChild(
        makeButton(timetable.isActive ? "Deactivate" : "Activate", () =>
          toggleActive(timetable),
        ),
      );
      actionsCell.appendChild(makeButton("Edit", () => startEdit(timetable)));

      row.appendChild(makeCell(timetable.course));
      row.appendChild(
        makeCell((timetable.class && timetable.class.name) || "Unassigned"),
      );
      row.appendChild(
        makeCell((timetable.instructor && timetable.instructor.name) || "N/A"),
      );
      row.appendChild(makeCell(timetable.daysOfWeek.join(", ")));
      row.appendChild(makeCell(timetable.startTime));
      row.appendChild(makeCell(timetable.endTime));
      row.appendChild(makeCell(timetable.isActive ? "Active" : "Inactive"));
      row.appendChild(actionsCell);

      tableBody.appendChild(row);
    });
  };

  // ---------- Actions ----------
  const toggleActive = async (timetable) => {
    const action = timetable.isActive ? "deactivate" : "activate";

    const res = await api(`/timetable/${timetable._id}/${action}`, {
      method: "PATCH",
    });

    showToast(
      res.data.message || (res.ok ? "Timetable updated" : "Update failed"),
      res.ok ? "success" : "error",
    );

    if (res.ok) {
      await loadTimetables();
    }
  };

  const startEdit = async (timetable) => {
    await Promise.all([loadInstructors(), loadClasses()]);
    resetForm();

    const instructorId = idOf(timetable.instructor);
    const instructor = state.instructors.find((i) => i._id === instructorId);
    const instructorName =
      (instructor && instructor.name) ||
      (timetable.instructor && timetable.instructor.name) ||
      "";

    state.editingId = timetable._id;
    state.selectedDays = [...timetable.daysOfWeek];

    courseInput.value = timetable.course;
    classSelect.value = idOf(timetable.class) || "";
    instructorInput.value = instructorName;
    instructorInput.dataset.instructorId = instructorName ? instructorId : "";
    startInput.value = timetable.startTime;
    endInput.value = timetable.endTime;
    fromInput.value = toDateInput(timetable.effectiveFrom);
    untilInput.value = toDateInput(timetable.effectiveUntil);

    formTitle.textContent = "Edit Timetable";
    submitButton.textContent = "Update Timetable";

    syncDayButtons();
    setFormOpen(true);
    formPanel.scrollIntoView({ behavior: "smooth", block: "nearest" });
  };

  const toggleForm = async () => {
    if (formPanel.style.display === "block") {
      setFormOpen(false);
      resetForm();
      return;
    }

    resetForm();
    setFormOpen(true);
    await Promise.all([loadInstructors(), loadClasses()]);
  };

  const submitForm = async (event) => {
    event.preventDefault();

    const { data, error } = readForm();

    if (error) {
      showToast(error, "error");
      return;
    }

    await withBusy(submitButton, async () => {
      const editing = Boolean(state.editingId);

      const res = await api(
        editing ? `/timetable/${state.editingId}` : "/timetable",
        { method: editing ? "PATCH" : "POST", body: data },
      );

      showToast(
        res.data.message ||
          (res.ok ? "Timetable saved" : "Could not save timetable"),
        res.ok ? "success" : "error",
      );

      if (!res.ok) {
        return;
      }

      resetForm();
      setFormOpen(false);
      await loadTimetables();
    });
  };

  // ---------- Wire up ----------
  manageButton.addEventListener("click", async () => {
    showPanel("timetableContainer", manageButton);
    await loadTimetables();
  });

  toggleButton.addEventListener("click", toggleForm);
  form.addEventListener("submit", submitForm);

  // Click a day to select it; click its x to remove it
  dayButtons.forEach((button) => {
    button.addEventListener("click", (event) => {
      const day = button.dataset.day;

      if (event.target.closest(".remove-day")) {
        state.selectedDays = state.selectedDays.filter((d) => d !== day);
      } else if (!state.selectedDays.includes(day)) {
        state.selectedDays.push(day);
      }

      syncDayButtons();
    });
  });
});
</file>

<file path="frontend/js/users.js">
// Admin: user list (change a student's class, activate / deactivate) and
// user creation.
// Needs: common.js (NIIT helpers) loaded first.
document.addEventListener("DOMContentLoaded", () => {
  if (!document.getElementById("usersContainer")) {
    return;
  }

  const {
    api,
    showToast,
    withBusy,
    el,
    showPanel,
    makeCell,
    emptyRow,
    loadingRow,
    errorRow,
    getUser,
    getClasses,
    fillSelect,
  } = NIIT;
  const byId = (id) => document.getElementById(id);

  const me = getUser();

  // ---------- DOM ----------
  const manageButton = byId("manageUsersButton");
  const createButton = byId("createUserButton");
  const tableBody = byId("usersTableBody");
  const form = byId("createUserForm");
  const submitButton = form.querySelector('button[type="submit"]');
  const roleSelect = byId("userRole");
  const classGroup = byId("userClassGroup");
  const classSelect = byId("userClass");

  // ---------- State ----------
  const state = { users: [], classes: [] };

  const idOf = (ref) => (ref && ref._id) || ref || "";

  // ---------- Classes ----------
  const loadClasses = async (force = false) => {
    const { classes, error } = await getClasses(force);

    if (error) {
      showToast(error, "error");
    }

    state.classes = classes;
  };

  // Students pick a class when they are created; other roles never have one
  const syncClassField = () => {
    const isStudent = roleSelect.value === "student";

    classGroup.hidden = !isStudent;
    classSelect.required = isStudent;
  };

  const fillCreateClassSelect = () =>
    fillSelect(classSelect, state.classes, {
      placeholder: state.classes.length
        ? "Select class"
        : "No classes yet - add one first",
      selected: classSelect.value,
    });

  // ---------- Render ----------
  const makeButton = (
    label,
    onClick,
    { disabled = false, title = "" } = {},
  ) => {
    const button = el("button", {
      type: "button",
      text: label,
      disabled,
      title,
    });

    button.addEventListener("click", () => withBusy(button, onClick));

    return button;
  };

  // Students get a dropdown that saves as soon as it changes
  const classCell = (user) => {
    if (user.role !== "student") {
      return makeCell("-");
    }

    const select = el("select", {
      className: "inline-select",
      "aria-label": `Class for ${user.name}`,
    });

    const sync = () => select.classList.toggle("unassigned", !select.value);

    fillSelect(select, state.classes, {
      placeholder: "Unassigned",
      selected: idOf(user.class),
    });
    sync();

    select.addEventListener("change", () => {
      sync();
      changeClass(user, select);
    });

    return makeCell(select);
  };

  const renderUsers = () => {
    tableBody.replaceChildren();

    if (!state.users.length) {
      tableBody.appendChild(emptyRow(6, "No users found."));
      return;
    }

    state.users.forEach((user) => {
      const isSelf = Boolean(me) && me.id === user._id;
      const row = document.createElement("tr");
      const actionsCell = makeCell("");

      actionsCell.appendChild(
        makeButton(
          user.status === "active" ? "Deactivate" : "Activate",
          () => toggleStatus(user),
          {
            disabled: isSelf,
            title: isSelf ? "You can't deactivate your own account" : "",
          },
        ),
      );

      row.appendChild(makeCell(user.name));
      row.appendChild(makeCell(user.email));
      row.appendChild(makeCell(user.role));
      row.appendChild(classCell(user));
      row.appendChild(makeCell(user.status));
      row.appendChild(actionsCell);

      tableBody.appendChild(row);
    });
  };

  // ---------- Data ----------
  const loadUsers = async () => {
    tableBody.replaceChildren(loadingRow(6));

    const [res] = await Promise.all([api("/users"), loadClasses()]);

    if (!res.ok) {
      const message = res.data.message || "Could not load users";

      showToast(message, "error");
      tableBody.replaceChildren(errorRow(6, message));
      return;
    }

    state.users = res.data.users || [];
    renderUsers();
  };

  // ---------- Actions ----------
  const changeClass = async (user, select) => {
    const previous = idOf(user.class);
    const res = await api(`/users/${user._id}`, {
      method: "PATCH",
      body: { class: select.value || null },
    });

    showToast(
      res.data.message || (res.ok ? "Class updated" : "Could not update class"),
      res.ok ? "success" : "error",
    );

    if (res.ok) {
      user.class = res.data.user.class;
      return;
    }

    // Put the dropdown back so it never shows something that wasn't saved
    select.value = previous;
    select.classList.toggle("unassigned", !select.value);
  };

  const toggleStatus = async (user) => {
    const deactivating = user.status === "active";

    if (
      deactivating &&
      !window.confirm(
        `Deactivate ${user.name}? They will be signed out and won't be able to log in.`,
      )
    ) {
      return;
    }

    const res = await api(`/users/${user._id}`, {
      method: "PATCH",
      body: { status: deactivating ? "inactive" : "active" },
    });

    showToast(
      res.data.message || (res.ok ? "User updated" : "Could not update user"),
      res.ok ? "success" : "error",
    );

    if (res.ok) {
      user.status = res.data.user.status;
      renderUsers();
    }
  };

  const createUser = async (event) => {
    event.preventDefault();

    const role = roleSelect.value;

    const body = {
      name: byId("userName").value.trim(),
      email: byId("userEmail").value.trim(),
      password: byId("userPassword").value,
      role,
    };

    if (role === "student") {
      if (!classSelect.value) {
        showToast("Please choose a class for the student", "error");
        return;
      }

      body.class = classSelect.value;
    }

    await withBusy(submitButton, async () => {
      const res = await api("/users", { method: "POST", body });

      showToast(
        res.data.message || (res.ok ? "User created" : "Could not create user"),
        res.ok ? "success" : "error",
      );

      if (res.ok) {
        form.reset();
        syncClassField();
        fillCreateClassSelect();
      }
    });
  };

  // ---------- Wire up ----------
  manageButton.addEventListener("click", async () => {
    showPanel("usersContainer", manageButton);
    await loadUsers();
  });

  createButton.addEventListener("click", async () => {
    showPanel("createUserContainer", createButton);
    syncClassField();
    await loadClasses();
    fillCreateClassSelect();
  });

  roleSelect.addEventListener("change", syncClassField);
  form.addEventListener("submit", createUser);
});
</file>

<file path="frontend/dashboard.html">
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard</title>
    <link rel="stylesheet" href="./css/style.css">
</head>
<body>
    <a class="skip-link" href="#main">Skip to content</a>

    <dialog id="sessionDialog" aria-labelledby="sessionDialogTitle">
        <form id="sessionDialogForm" novalidate>
            <h3 id="sessionDialogTitle"></h3>
            <p id="sessionDialogSummary" class="dialog-summary"></p>

            <div class="form-group" id="sessionReasonGroup">
                <label for="sessionReason">Reason (optional)</label>
                <input type="text" id="sessionReason" maxlength="200" autocomplete="off">
            </div>

            <label class="check-row" id="scheduleReplacementRow">
                <input type="checkbox" id="scheduleReplacement" checked>
                <span>Schedule a replacement session now</span>
            </label>

            <div id="replacementFields">
                <div class="form-group">
                    <label for="replacementDate">Replacement date</label>
                    <input type="date" id="replacementDate">
                </div>

                <div class="field-pair">
                    <div class="form-group">
                        <label for="replacementStart">Start</label>
                        <input type="time" id="replacementStart">
                    </div>

                    <div class="form-group">
                        <label for="replacementEnd">End</label>
                        <input type="time" id="replacementEnd">
                    </div>
                </div>
            </div>

            <p id="sessionDialogError" class="error" role="alert"></p>

            <div class="dialog-actions">
                <button type="button" id="sessionDialogCancel" class="btn-outline">Close</button>
                <button type="submit" id="sessionDialogConfirm">Confirm</button>
            </div>
        </form>
    </dialog>

        <dialog id="rosterDialog" aria-labelledby="rosterTitle">
        <h3 id="rosterTitle"></h3>
        <p id="rosterSummary" class="dialog-summary"></p>
        <p id="rosterCounts" class="roster-counts" aria-live="polite"></p>

        <p id="rosterError" class="error" role="alert"></p>

        <div class="roster-scroll">
            <table>
                <thead>
                    <tr>
                        <th>Student</th>
                        <th>Status</th>
                        <th>Signed in</th>
                        <th>Signed out</th>
                        <th>Counted</th>
                    </tr>
                </thead>

                <tbody id="rosterBody">
                </tbody>
            </table>
        </div>

        <div class="dialog-actions">
            <button type="button" id="rosterRefresh" class="btn-outline">Refresh</button>
            <button type="button" id="rosterClose">Close</button>
        </div>
    </dialog>

        <dialog id="passwordDialog" aria-labelledby="passwordDialogTitle">
        <form id="passwordForm" novalidate>
            <h3 id="passwordDialogTitle">Change password</h3>

            <div class="form-group">
                <label for="currentPassword">Current password</label>
                <input type="password" id="currentPassword" autocomplete="current-password">
            </div>

            <div class="form-group">
                <label for="newPassword">New password</label>
                <input type="password" id="newPassword" autocomplete="new-password">
                <small class="field-hint">8 to 72 characters.</small>
            </div>

            <div class="form-group">
                <label for="confirmPassword">Confirm new password</label>
                <input type="password" id="confirmPassword" autocomplete="new-password">
            </div>

            <p id="passwordError" class="error" role="alert"></p>

            <div class="dialog-actions">
                <button type="button" id="passwordCancel" class="btn-outline">Cancel</button>
                <button type="submit" id="passwordSubmit">Change password</button>
            </div>
        </form>
    </dialog>

        <dialog id="missedDialog" aria-labelledby="missedTitle">
        <h3 id="missedTitle"></h3>
        <p id="missedSummary" class="dialog-summary"></p>
        <p id="missedCounts" class="roster-counts" aria-live="polite"></p>

        <div class="roster-scroll">
            <table>
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Time</th>
                        <th>Course</th>
                        <th>What happened</th>
                    </tr>
                </thead>

                <tbody id="missedBody">
                </tbody>
            </table>
        </div>

        <div class="dialog-actions">
            <button type="button" id="missedClose">Close</button>
        </div>
    </dialog>

    <div id="toast" class="toast" role="status" aria-live="polite"></div>
    <div id="dashboard">
        <header class="topbar">
            <img class="topbar-logo" src="./img/niit-logo-white.png" alt="NIIT">

            <div class="topbar-user">
                <span id="welcomeMessage"></span>
                <span id="roleBadge" class="badge badge-role"></span>
                <div class="notifications">
                    <button type="button" id="notificationsButton" class="icon-button"
                            aria-label="Notifications" aria-expanded="false" aria-controls="notificationsPanel">
                        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor"
                             stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/>
                            <path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/>
                        </svg>
                        <span id="notificationsCount" class="notification-count" aria-hidden="true" hidden></span>
                    </button>

                    <div id="notificationsPanel" class="notifications-panel" role="region"
                         aria-labelledby="notificationsTitle" hidden>
                        <div class="notifications-head">
                            <strong id="notificationsTitle">Notifications</strong>
                            <button type="button" id="notificationsMarkAll" class="link-button" disabled>Mark all read</button>
                        </div>

                        <p id="notificationsStatus" class="notifications-status" role="status"></p>

                        <ul id="notificationsList" class="notifications-list"></ul>

                        <button type="button" id="notificationsMore" class="btn-outline" hidden>Load more</button>
                    </div>
                </div>
                <button id="changePasswordButton">Change password</button>
                <button id="logoutButton">Log out</button>
            </div>
        </header>

        <main class="content" id="main" tabindex="-1">
        <section id="roleNotice" class="notice" hidden></section>

        <div id="adminDashboard">
            <h2>Admin Dashboard</h2>
            <p class="page-subtitle">Manage users, timetables and attendance records.</p>

            <div class="admin-actions" role="group" aria-label="Admin sections">
                <button id="manageUsersButton">Manage Users</button>

                <button id="createUserButton">Create User</button>

                <button id="manageClassesButton">Manage Classes</button>

                <button id="manageTimetableButton">Manage Timetables</button>

                <button id="manageSessionsButton">Manage Sessions</button>

                <button id="attendanceSummaryButton">Attendance Summary</button>

                <button id="attendanceReportsButton">Attendance Reports</button>
            </div>

            <div id="usersContainer">
                <h3>Users</h3>

                <table>

                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Role</th>
                            <th>Class</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody id="usersTableBody">
                    </tbody>

                </table>

            </div>

            <div id="createUserContainer">
                <h3>Create User</h3>

                <form id="createUserForm">

                    <div class="form-group">
                        <label for="userName">Name</label>
                        <input type="text" id="userName" autocomplete="off" required>
                    </div>

                    <div class="form-group">
                        <label for="userEmail">Email</label>
                        <input type="email" id="userEmail" autocomplete="off" required>
                    </div>

                    <div class="form-group">
                        <label for="userPassword">Password</label>
                        <input type="password" id="userPassword" autocomplete="new-password" minlength="8" required>
                    </div>

                    <div class="form-group">
                        <label for="userRole">Role</label>
                        <select id="userRole" required>
                            <option value="">Select role</option>
                            <option value="student">Student</option>
                            <option value="instructor">Instructor</option>
                            <option value="admin">Admin</option>
                        </select>
                    </div>

                    <div class="form-group" id="userClassGroup" hidden>
                        <label for="userClass">Class</label>
                        <select id="userClass">
                            <option value="">Select class</option>
                        </select>
                    </div>

                    <button type="submit">Create User</button>

                    <p id="createUserMessage"></p>

                </form>
            </div>

            <div id="classesContainer">
                <div class="panel-head">
                    <h3>Classes</h3>
                </div>

                <form id="createClassForm" class="inline-form">
                    <div class="form-group">
                        <label for="className">New class name</label>
                        <input
                            type="text"
                            id="className"
                            placeholder="e.g. Cohort 12 - Full Stack"
                            autocomplete="off"
                            maxlength="80"
                            required
                        >
                    </div>

                    <button type="submit">Add class</button>
                </form>

                <table>
                    <thead>
                        <tr>
                            <th>Class</th>
                            <th>Students</th>
                            <th>Active timetables</th>
                        </tr>
                    </thead>

                    <tbody id="classesTableBody">
                    </tbody>
                </table>
            </div>

            <div id="timetableContainer">
                <div class="panel-head">
                    <h3>Timetable</h3>

