<file path="frontend/js/instructor.js">
// Instructor dashboard: own schedule (with a roster for each session), own
// timetables, and an attendance report for their classes.
// Needs: common.js and report.js loaded first.
document.addEventListener("DOMContentLoaded", () => {
  const dashboard = document.getElementById("instructorDashboard");
  const user = NIIT.getUser();

  // The instructor section is in the page for every role
  if (!dashboard || !user || user.role !== "instructor") {
    return;
  }

  const {
    api,
    showToast,
    withBusy,
    el,
    showPanel,
    makeCell,
    emptyRow,
    loadingRow,
    errorRow,
    formatDate,
    formatClock,
    fillSelect,
  } = NIIT;
  const byId = (id) => document.getElementById(id);

  // ---------- DOM ----------
  const scheduleButton = byId("instructorScheduleButton");
  const timetablesButton = byId("instructorTimetablesButton");
  const reportButton = byId("instructorReportButton");

  const fromInput = byId("instructorFrom");
  const toInput = byId("instructorTo");
  const classFilter = byId("instructorClassFilter");
  const loadButton = byId("instructorLoadSchedule");
  const scheduleBody = byId("instructorScheduleBody");
  const timetablesBody = byId("instructorTimetablesBody");

  const rosterDialog = byId("rosterDialog");
  const rosterTitle = byId("rosterTitle");
  const rosterSummary = byId("rosterSummary");
  const rosterCounts = byId("rosterCounts");
  const rosterError = byId("rosterError");
  const rosterBody = byId("rosterBody");
  const rosterRefresh = byId("rosterRefresh");
  const rosterClose = byId("rosterClose");

  // ---------- State ----------
  const state = {
    timetables: [],
    entries: [],
    today: "",
    rosterSessionId: null,
    datesSet: false,
  };

  // ---------- Dates ----------
  const DAY_MS = 24 * 60 * 60 * 1000;

  const todayLagos = () =>
    new Intl.DateTimeFormat("en-CA", { timeZone: "Africa/Lagos" }).format(
      new Date(),
    );

  const addDays = (key, days) =>
    new Date(new Date(`${key}T00:00:00.000Z`).getTime() + days * DAY_MS)
      .toISOString()
      .slice(0, 10);

  const weekday = (key) =>
    new Date(`${key}T00:00:00.000Z`).toLocaleDateString("en-GB", {
      timeZone: "UTC",
      weekday: "short",
    });

  const slot = (item) => `${item.startTime}\u00a0\u2013\u00a0${item.endTime}`;

  // ---------- Timetables (also feed the class / course filters) ----------
  const loadTimetables = async () => {
    const res = await api("/timetable");

    if (!res.ok) {
      showToast(res.data.message || "Could not load your timetables", "error");
      return false;
    }

    state.timetables = res.data.timetables || [];

    return true;
  };

  // The classes this instructor teaches, from their timetables
  const myClasses = () => {
    const seen = new Map();

    state.timetables.forEach((timetable) => {
      if (timetable.class && !seen.has(timetable.class._id)) {
        seen.set(timetable.class._id, timetable.class);
      }
    });

    return [...seen.values()].sort((a, b) => a.name.localeCompare(b.name));
  };

  const renderTimetables = () => {
    timetablesBody.replaceChildren();

    if (!state.timetables.length) {
      timetablesBody.appendChild(
        emptyRow(
          6,
          "You have no timetables yet. An administrator sets these up.",
        ),
      );
      return;
    }

    state.timetables.forEach((timetable) => {
      const row = document.createElement("tr");

      row.append(
        makeCell(timetable.course),
        makeCell((timetable.class && timetable.class.name) || "Unassigned"),
        makeCell(timetable.daysOfWeek.join(", ")),
        makeCell(timetable.startTime),
        makeCell(timetable.endTime),
        makeCell(timetable.isActive ? "Active" : "Inactive"),
      );

      timetablesBody.appendChild(row);
    });
  };

  // ---------- Schedule ----------
  const detailLines = (entry) => {
    const lines = [];

    if (entry.reason) {
      lines.push(`Reason: ${entry.reason}`);
    }

    if (entry.replacement) {
      lines.push(
        `Moved to ${weekday(entry.replacement.date)} ${formatDate(entry.replacement.date)}, ${entry.replacement.startTime}\u00a0\u2013\u00a0${entry.replacement.endTime}`,
      );
    } else if (entry.status === "postponed") {
      lines.push("No replacement scheduled yet");
    }

    if (entry.original) {
      lines.push(
        `Replaces ${weekday(entry.original.date)} ${formatDate(entry.original.date)}, ${entry.original.startTime}\u00a0\u2013\u00a0${entry.original.endTime}`,
      );
    }

    return lines;
  };

  const rosterButton = (entry) => {
    const button = el("button", {
      type: "button",
      text: "Roster",
      title: "See who has checked in",
    });

    button.addEventListener("click", () =>
      withBusy(button, () => openRoster(entry)),
    );

    return button;
  };

  const renderSchedule = () => {
    scheduleBody.replaceChildren();

    if (!state.entries.length) {
      scheduleBody.appendChild(
        emptyRow(6, "No classes in this period. Try a different date range."),
      );
      return;
    }

    state.entries.forEach((entry) => {
      const row = el("tr", {
        className:
          [
            entry.isReplacement ? "replacement" : "",
            entry.date === state.today ? "today" : "",
          ]
            .join(" ")
            .trim() || undefined,
      });

      const dateCell = makeCell(
        el(
          "span",
          {},
          `${weekday(entry.date)} ${formatDate(entry.date)}`,
          entry.date === state.today
            ? el("span", { className: "badge badge-role", text: "Today" })
            : null,
        ),
      );

      const courseCell = makeCell(
        el(
          "span",
          {},
          entry.course,
          entry.isReplacement
            ? el("span", {
                className: "badge badge-muted",
                text: "Replacement",
              })
            : null,
        ),
      );

      // Only days that already have a session record can show a roster; later
      // days get theirs when the day comes
      const rosterCell = entry.id
        ? makeCell(rosterButton(entry))
        : makeCell(
            el("span", { className: "muted", text: "Opens on the day" }),
          );

      row.append(
        dateCell,
        makeCell(slot(entry)),
        courseCell,
        makeCell((entry.class && entry.class.name) || "Unassigned"),
        makeCell(entry.status),
        rosterCell,
      );

      scheduleBody.appendChild(row);
    });
  };

  const loadSchedule = async () => {
    const params = new URLSearchParams();

    if (fromInput.value) {
      params.set("from", fromInput.value);
    }

    if (toInput.value) {
      params.set("to", toInput.value);
    }

    if (classFilter.value) {
      params.set("class", classFilter.value);
    }

    scheduleBody.replaceChildren(loadingRow(6));

    const res = await api(`/sessions/schedule?${params}`);

    if (!res.ok) {
      const message = res.data.message || "Could not load your schedule";

      showToast(message, "error");
      scheduleBody.replaceChildren(errorRow(6, message));
      return;
    }

    state.entries = res.data.sessions || [];
    state.today = res.data.today || "";

    renderSchedule();
  };

  // ---------- Roster ----------
  // A student with no record is "Not checked in" while the class is running,
  // "Absent" once it has ended, and nothing special if it never took place
  const statusOf = (item, info) => {
    const record = item.attendance;

    if (record) {
      return record.isValid ? record.status : "Invalid";
    }

    if (
      info.session.status === "cancelled" ||
      info.session.status === "postponed"
    ) {
      return "-";
    }

    if (info.ended) {
      return "Absent";
    }

    return info.started ? "Not checked in" : "Not started";
  };

  const attendedLabel = (record) => {
    if (!record) {
      return "-";
    }

    if (record.classAttended === true) {
      return "Yes";
    }

    return record.classAttended === false ? "No" : "Pending";
  };

  const renderRoster = (info) => {
    const { session } = info;
    const statuses = info.roster.map((item) => statusOf(item, info));
    const count = (label) => statuses.filter((s) => s === label).length;

    rosterTitle.textContent = session.course;
    rosterSummary.textContent = `${(session.class && session.class.name) || "No class"} \u00b7 ${weekday(session.date)} ${formatDate(session.date)}, ${slot(session)}`;

    const missing = info.ended ? "Absent" : "Not checked in";
    const parts = [
      `Present ${count("present")}`,
      `Late ${count("late")}`,
      ...(session.status === "cancelled" || session.status === "postponed"
        ? [`Session ${session.status}`]
        : [`${missing} ${count(missing)}`]),
      `Total ${info.roster.length}`,
    ];

    rosterCounts.textContent = parts.join(" \u00b7 ");

    rosterBody.replaceChildren();

    if (!info.roster.length) {
      rosterBody.appendChild(
        emptyRow(5, "No students are assigned to this class yet."),
      );
      return;
    }

    info.roster.forEach((item, index) => {
      const record = item.attendance;
      const row = document.createElement("tr");

      row.append(
        makeCell(item.student.name),
        makeCell(statuses[index]),
        makeCell(record && record.signIn ? formatClock(record.signIn) : "-"),
        makeCell(record && record.signOut ? formatClock(record.signOut) : "-"),
        makeCell(attendedLabel(record)),
      );

      rosterBody.appendChild(row);
    });
  };

  const showRosterDialog = () =>
    typeof rosterDialog.showModal === "function"
      ? rosterDialog.showModal()
      : rosterDialog.setAttribute("open", "");

  const closeRosterDialog = () => {
    if (typeof rosterDialog.close === "function") {
      rosterDialog.close();
    } else {
      rosterDialog.removeAttribute("open");
    }

    state.rosterSessionId = null;
  };

  const loadRoster = async () => {
    if (!state.rosterSessionId) {
      return;
    }

    const res = await api(`/sessions/${state.rosterSessionId}/roster`);

    if (!res.ok) {
      // A toast would sit behind the open dialog, so show the error inside it
      rosterError.textContent = res.data.message || "Could not load the roster";
      return;
    }

    rosterError.textContent = "";
    renderRoster(res.data);
  };

  const openRoster = async (entry) => {
    state.rosterSessionId = entry.id;

    rosterTitle.textContent = entry.course;
    rosterSummary.textContent = "Loading...";
    rosterCounts.textContent = "";
    rosterError.textContent = "";
    rosterBody.replaceChildren(loadingRow(5));

    showRosterDialog();
    await loadRoster();
  };

  // ---------- Panels ----------
  const openSchedule = async () => {
    showPanel("instructorScheduleContainer", scheduleButton);

    if (!state.datesSet) {
      state.datesSet = true;
      fromInput.value = fromInput.value || todayLagos();
      toInput.value = toInput.value || addDays(fromInput.value, 13);
    }

    await loadTimetables();

    fillSelect(classFilter, myClasses(), {
      placeholder: "All my classes",
      selected: classFilter.value,
    });

    await loadSchedule();
  };

  const openTimetables = async () => {
    showPanel("instructorTimetablesContainer", timetablesButton);
    timetablesBody.replaceChildren(loadingRow(6));

    if (await loadTimetables()) {
      renderTimetables();
    } else {
      timetablesBody.replaceChildren(
        errorRow(6, "Could not load your timetables"),
      );
    }
  };

  const report = NIIT.createReport({
    path: "/reports/instructor/attendance",
    classPlaceholder: "All my classes",
    ids: {
      course: "instCourse",
      class: "instClass",
      student: "instStudent",
      date: "instDate",
      courseList: "instCourseList",
      studentList: "instStudentList",
      apply: "instApply",
      clear: "instClear",
      export: "instExport",
      tableBody: "instReportBody",
      count: "instCount",
      pager: "instPager",
      prev: "instPrev",
      next: "instNext",
      pageInfo: "instPageInfo",
    },
    loadOptions: async () => {
      const [students, timetablesOk] = await Promise.all([
        api("/users/my-students"),
        loadTimetables(),
      ]);

      return {
        students: students.ok ? students.data.students || [] : [],
        courses: [...new Set(state.timetables.map((t) => t.course))],
        classes: myClasses(),
        failed: !students.ok || !timetablesOk,
      };
    },
  });

  const openReport = async () => {
    showPanel("instructorReportContainer", reportButton);
    await report.open();
  };

  const summaryButton = byId("instructorSummaryButton");

  const summary = NIIT.createSummary({
    ids: {
      class: "isumClass",
      course: "isumCourse",
      courseList: "isumCourseList",
      from: "isumFrom",
      to: "isumTo",
      sort: "isumSort",
      show: "isumShow",
      export: "isumExport",
      info: "isumInfo",
      body: "isumBody",
    },
    loadOptions: async () => {
      const ok = await loadTimetables();

      return {
        classes: myClasses(),
        courses: [...new Set(state.timetables.map((t) => t.course))],
        failed: !ok,
      };
    },
  });

  const openSummary = async () => {
    showPanel("instructorSummaryContainer", summaryButton);
    await summary.open();
  };

  // ---------- Wire up ----------
  summaryButton.addEventListener("click", openSummary);
  scheduleButton.addEventListener("click", openSchedule);
  timetablesButton.addEventListener("click", openTimetables);
  reportButton.addEventListener("click", openReport);

  loadButton.addEventListener("click", () =>
    withBusy(loadButton, loadSchedule),
  );
  classFilter.addEventListener("change", loadSchedule);

  rosterRefresh.addEventListener("click", () =>
    withBusy(rosterRefresh, loadRoster),
  );
  rosterClose.addEventListener("click", closeRosterDialog);
  rosterDialog.addEventListener("close", () => {
    state.rosterSessionId = null;
  });

  // Start on the schedule: it's what an instructor opens the page to see
  openSchedule();
});
</file>

<file path="frontend/js/notifications.js">
// Notification bell: an unread count in the top bar and a dropdown inbox for
// the signed-in user (any role). Notices are created by the server when an
// admin changes a class (postponed, cancelled, new date, undone...).
// Needs: common.js loaded first.
document.addEventListener("DOMContentLoaded", () => {
  const button = document.getElementById("notificationsButton");

  if (!button || !NIIT.getUser()) {
    return;
  }

  const { api, showToast, withBusy, el } = NIIT;
  const byId = (id) => document.getElementById(id);

  const countBadge = byId("notificationsCount");
  const panel = byId("notificationsPanel");
  const list = byId("notificationsList");
  const status = byId("notificationsStatus");
  const markAllButton = byId("notificationsMarkAll");
  const moreButton = byId("notificationsMore");

  const PAGE_SIZE = 10;
  const POLL_MS = 60000;

  const state = {
    open: false,
    unread: 0,
    page: 0,
    totalPages: 1,
    items: [],
  };

  // ---------- Helpers ----------
  const timeAgo = (value) => {
    const minutes = Math.floor(
      (Date.now() - new Date(value).getTime()) / 60000,
    );

    if (minutes < 1) {
      return "Just now";
    }

    if (minutes < 60) {
      return `${minutes} min ago`;
    }

    const hours = Math.floor(minutes / 60);

    if (hours < 24) {
      return `${hours} ${hours === 1 ? "hour" : "hours"} ago`;
    }

    const days = Math.floor(hours / 24);

    if (days < 7) {
      return `${days} ${days === 1 ? "day" : "days"} ago`;
    }

    return new Date(value).toLocaleDateString("en-GB", {
      timeZone: "Africa/Lagos",
      day: "numeric",
      month: "short",
      year: "numeric",
    });
  };

  // ---------- Count ----------
  const setCount = (count) => {
    state.unread = count;

    countBadge.hidden = count === 0;
    countBadge.textContent = count > 99 ? "99+" : String(count);

    // Screen readers hear the number, since the badge itself is decorative
    button.setAttribute(
      "aria-label",
      count ? `Notifications, ${count} unread` : "Notifications",
    );

    markAllButton.disabled = count === 0;
  };

  // ---------- List ----------
  const renderList = () => {
    list.replaceChildren(
      ...state.items.map((item) => {
        const open = el(
          "button",
          {
            type: "button",
            className: `notification-item${item.read ? "" : " unread"}`,
          },
          item.read
            ? null
            : el("span", { className: "sr-only", text: "Unread: " }),
          el("strong", { className: "notification-title", text: item.title }),
          el("span", { className: "notification-message", text: item.message }),
          el("span", {
            className: "notification-time",
            text: timeAgo(item.createdAt),
          }),
        );

        open.addEventListener("click", () => markRead(item));

        return el("li", {}, open);
      }),
    );

    moreButton.hidden = state.page >= state.totalPages;
    status.textContent = state.items.length ? "" : "You have no notifications.";
  };

  const load = async (page) => {
    if (page === 1) {
      status.textContent = "Loading...";
    }

    const res = await api(`/notifications?page=${page}&limit=${PAGE_SIZE}`);

    if (!res.ok) {
      status.textContent = res.data.message || "Could not load notifications.";
      return;
    }

    state.page = res.data.pagination.page;
    state.totalPages = res.data.pagination.totalPages;
    state.items =
      page === 1
        ? res.data.notifications
        : [...state.items, ...res.data.notifications];

    setCount(res.data.unreadCount);
    renderList();
  };

  // ---------- Actions ----------
  const markRead = async (item) => {
    if (item.read) {
      return;
    }

    const res = await api(`/notifications/${item._id}/read`, {
      method: "PATCH",
    });

    if (!res.ok) {
      showToast(
        res.data.message || "Could not update the notification",
        "error",
      );
      return;
    }

    item.read = true;
    setCount(Math.max(0, state.unread - 1));
    renderList();
  };

  const markAllRead = async () => {
    const res = await api("/notifications/read-all", { method: "PATCH" });

    if (!res.ok) {
      showToast(res.data.message || "Could not update notifications", "error");
      return;
    }

    state.items.forEach((item) => (item.read = true));
    setCount(0);
    renderList();
  };

  // ---------- Open / close ----------
  const setOpen = (open, { restoreFocus = false } = {}) => {
    state.open = open;
    panel.hidden = !open;
    button.setAttribute("aria-expanded", String(open));

    if (open) {
      load(1);
    } else if (restoreFocus) {
      button.focus();
    }
  };

  button.addEventListener("click", () => setOpen(!state.open));

  document.addEventListener("click", (event) => {
    if (
      state.open &&
      !panel.contains(event.target) &&
      !button.contains(event.target)
    ) {
      setOpen(false);
    }
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && state.open) {
      setOpen(false, { restoreFocus: true });
    }
  });

  // Not withBusy: setCount() decides whether this button is enabled (it is
  // disabled when nothing is unread), and withBusy would switch it back on.
  markAllButton.addEventListener("click", async () => {
    markAllButton.disabled = true;
    await markAllRead();
    setCount(state.unread);
  });

  moreButton.addEventListener("click", () =>
    withBusy(moreButton, () => load(state.page + 1)),
  );

  // ---------- Polling ----------
  // A cheap count every minute (only while the tab is visible). If the inbox
  // is open and something new arrived, it refreshes itself.
  const poll = async () => {
    if (document.hidden) {
      return;
    }

    const res = await api("/notifications/unread-count");

    if (!res.ok) {
      return; // a missed poll isn't worth bothering anyone about
    }

    const changed = res.data.count !== state.unread;

    setCount(res.data.count);

    if (changed && state.open) {
      load(1);
    }
  };

  document.addEventListener("visibilitychange", poll);
  setInterval(poll, POLL_MS);

  setCount(0);
  poll();
});
</file>

<file path="frontend/js/report.js">
// Shared attendance report: combinable filters, paging and CSV export.
// Used by the admin and instructor dashboards; each passes its own endpoint,
// element ids and a function that loads the filter options.
// Needs: common.js (NIIT helpers) loaded first.
(() => {
  const {
    api,
    showToast,
    withBusy,
    el,
    createAutocomplete,
    buildAttendanceRow,
    emptyRow,
    loadingRow,
    errorRow,
    formatDateTime,
    fillSelect,
  } = NIIT;

  const PAGE_SIZE = 50; // rows per page on screen
  const EXPORT_PAGE_SIZE = 200; // the server's maximum, used to export fast
  const EXPORT_MAX = 20000; // beyond this, ask to narrow the filters

  // ---------- CSV ----------
  // Spreadsheet apps run text that starts with = + - @ as a formula, so such
  // values (a student could have typed any name) are prefixed with a quote.
  const csvCell = (value) => {
    let text = value === null || value === undefined ? "" : String(value);

    if (/^[=+\-@\t\r]/.test(text)) {
      text = `'${text}`;
    }

    return /[",\n\r]/.test(text) ? `"${text.replace(/"/g, '""')}"` : text;
  };

  const CSV_HEADERS = [
    "Student",
    "Email",
    "Course",
    "Class",
    "Date",
    "Session start",
    "Session end",
    "Sign in",
    "Sign out",
    "Sign out method",
    "Status",
    "Class attended",
    "Valid",
    "Invalid reason",
  ];

  const classNameOf = (record) =>
    (record.session &&
      record.session.timetable &&
      record.session.timetable.class &&
      record.session.timetable.class.name) ||
    "";

  const csvRow = (record) => {
    const session = record.session || {};
    const student = record.student || {};

    let attended = "Pending";

    if (record.classAttended === true) {
      attended = "Yes";
    } else if (record.classAttended === false) {
      attended = "No";
    }

    return [
      student.name || "",
      student.email || "",
      session.course || "",
      classNameOf(record),
      session.date ? new Date(session.date).toISOString().slice(0, 10) : "",
      session.startTime || "",
      session.endTime || "",
      record.signIn ? formatDateTime(record.signIn) : "",
      record.signOut ? formatDateTime(record.signOut) : "",
      record.signOutMethod || "",
      record.status || "",
      attended,
      record.isValid ? "Valid" : "Invalid",
      record.invalidationReason || "",
    ]
      .map(csvCell)
      .join(",");
  };

  // Downloads lines of CSV text as a file
  const downloadLines = (filename, lines) => {
    // The BOM makes Excel read the file as UTF-8 (names with accents)
    const blob = new Blob([`\uFEFF${lines.join("\r\n")}`], {
      type: "text/csv;charset=utf-8",
    });
    const url = URL.createObjectURL(blob);
    const link = el("a", { href: url, download: filename });

    document.body.appendChild(link);
    link.click();
    link.remove();

    setTimeout(() => URL.revokeObjectURL(url), 1000);
  };

  const todayLagos = () =>
    new Intl.DateTimeFormat("en-CA", { timeZone: "Africa/Lagos" }).format(
      new Date(),
    );

  const downloadCsv = (records) =>
    downloadLines(`attendance-${todayLagos()}.csv`, [
      CSV_HEADERS.map(csvCell).join(","),
      ...records.map(csvRow),
    ]);

  NIIT.csvCell = csvCell;
  NIIT.downloadCsvLines = downloadLines;

  // ---------- The report ----------
  // ids: { course, class, student, instructor?, date, courseList, studentList,
  //        instructorList?, apply, clear, export, tableBody, count, pager,
  //        prev, next, pageInfo }  (element ids; instructor ones are optional)
  // loadOptions: async () => ({ students, instructors, courses, classes, failed })
  NIIT.createReport = ({
    path,
    ids,
    columns = 11,
    classPlaceholder = "All classes",
    loadOptions,
  }) => {
    const $ = (key) => (ids[key] ? document.getElementById(ids[key]) : null);

    const courseInput = $("course");
    const classSelect = $("class");
    const studentInput = $("student");
    const instructorInput = $("instructor"); // admin only
    const dateInput = $("date");
    const tableBody = $("tableBody");
    const countLine = $("count");
    const pager = $("pager");
    const prevButton = $("prev");
    const nextButton = $("next");
    const pageInfo = $("pageInfo");
    const lists = ["courseList", "studentList", "instructorList"]
      .map($)
      .filter(Boolean);

    // query = the filters last applied with "Filter" (page changes and export
    // use these, not whatever is half-typed in the boxes)
    const state = {
      students: [],
      instructors: [],
      courses: [],
      query: "",
      pagination: { page: 1, limit: PAGE_SIZE, total: 0, totalPages: 1 },
    };

    // ---------- Filters ----------
    createAutocomplete({
      input: courseInput,
      list: $("courseList"),
      getItems: () => state.courses,
    });

    // A student / instructor must be picked from the list so we have their id;
    // typing again invalidates the earlier pick
    createAutocomplete({
      input: studentInput,
      list: $("studentList"),
      getItems: () => state.students,
      getLabel: (student) => student.name,
      onType: () => {
        studentInput.dataset.studentId = "";
      },
      onSelect: (student) => {
        studentInput.dataset.studentId = student._id;
      },
    });

    if (instructorInput) {
      createAutocomplete({
        input: instructorInput,
        list: $("instructorList"),
        getItems: () => state.instructors,
        getLabel: (instructor) => instructor.name,
        onType: () => {
          instructorInput.dataset.instructorId = "";
        },
        onSelect: (instructor) => {
          instructorInput.dataset.instructorId = instructor._id;
        },
      });
    }

    const clearFilters = () => {
      courseInput.value = "";
      classSelect.value = "";
      studentInput.value = "";
      studentInput.dataset.studentId = "";
      dateInput.value = "";

      if (instructorInput) {
        instructorInput.value = "";
        instructorInput.dataset.instructorId = "";
      }

      lists.forEach((list) => (list.innerHTML = ""));
    };

    // Returns { query } (possibly empty = everything) or { error }
    const buildQuery = () => {
      if (studentInput.value.trim() && !studentInput.dataset.studentId) {
        return { error: "Please choose a student from the suggestions" };
      }

      if (
        instructorInput &&
        instructorInput.value.trim() &&
        !instructorInput.dataset.instructorId
      ) {
        return { error: "Please choose an instructor from the suggestions" };
      }

      const params = new URLSearchParams();
      const add = (name, value) => value && params.set(name, value);

      add("course", courseInput.value.trim());
      add("class", classSelect.value);
      add("student", studentInput.dataset.studentId);
      add("date", dateInput.value);

      if (instructorInput) {
        add("instructor", instructorInput.dataset.instructorId);
      }

      return { query: params.toString() };
    };

    const showLoading = () => tableBody.replaceChildren(loadingRow(columns));

    // ---------- Data ----------
    const applyOptions = (options) => {
      state.students = options.students || [];
      state.instructors = options.instructors || [];
      state.courses = options.courses || [];

      fillSelect(classSelect, options.classes || [], {
        placeholder: classPlaceholder,
        selected: classSelect.value,
      });

      if (options.failed) {
        showToast("Some filter options could not be loaded", "error");
      }
    };

    const fetchReport = (query = "", page = 1, limit = PAGE_SIZE) => {
      const params = new URLSearchParams(query);

      params.set("page", String(page));
      params.set("limit", String(limit));

      return api(`${path}?${params}`);
    };

    // ---------- Render ----------
    const renderRows = (records = []) => {
      const studentNames = new Map(state.students.map((s) => [s._id, s.name]));

      tableBody.replaceChildren();

      if (!records.length) {
        tableBody.appendChild(
          emptyRow(columns, "No attendance records found."),
        );
        return;
      }

      records.forEach((record) => {
        const studentId =
          (record.student && record.student._id) || record.student;
        const studentName =
          (record.student && record.student.name) ||
          studentNames.get(studentId) ||
          studentId;

        tableBody.appendChild(
          buildAttendanceRow(record, {
            studentName,
            className: classNameOf(record),
          }),
        );
      });
    };

    const renderPager = () => {
      const { page, limit, total, totalPages } = state.pagination;

      countLine.textContent = total
        ? `Showing ${(page - 1) * limit + 1}\u2013${Math.min(page * limit, total)} of ${total} ${total === 1 ? "record" : "records"}`
        : "0 records";

      pager.hidden = totalPages <= 1;
      pageInfo.textContent = `Page ${page} of ${totalPages}`;
      prevButton.disabled = page <= 1;
      nextButton.disabled = page >= totalPages;
    };

    const showReport = (res) => {
      if (!res.ok) {
        const message = res.data.message || "Could not load attendance";

        showToast(message, "error");
        tableBody.replaceChildren(errorRow(columns, message));
        return;
      }

      state.pagination = res.data.pagination || state.pagination;

      renderRows(res.data.attendance);
      renderPager();
    };

    // ---------- Export ----------
    // Collects every record matching the applied filters, one server page at a
    // time. Returns the records, or null after showing why it can't.
    const fetchAllRecords = async () => {
      const first = await fetchReport(state.query, 1, EXPORT_PAGE_SIZE);

      if (!first.ok) {
        showToast(first.data.message || "Could not export", "error");
        return null;
      }

      const { total, totalPages } = first.data.pagination;

      if (!total) {
        showToast("There are no records to export", "error");
        return null;
      }

      if (total > EXPORT_MAX) {
        showToast(
          `${total} records is too many to export at once. Narrow the filters (for example by class or date) and try again.`,
          "error",
        );
        return null;
      }

      let records = first.data.attendance;

      for (let page = 2; page <= totalPages; page++) {
        const res = await fetchReport(state.query, page, EXPORT_PAGE_SIZE);

        if (!res.ok) {
          showToast(res.data.message || "Could not export", "error");
          return null;
        }

        records = records.concat(res.data.attendance);
      }

      return records;
    };

    // ---------- Wire up ----------
    $("apply").addEventListener("click", () =>
      withBusy($("apply"), async () => {
        const { query, error } = buildQuery();

        if (error) {
          showToast(error, "error");
          return;
        }

        state.query = query;
        showLoading();
        showReport(await fetchReport(query));
      }),
    );

    $("clear").addEventListener("click", () =>
      withBusy($("clear"), async () => {
        clearFilters();
        state.query = "";
        showLoading();
        showReport(await fetchReport());
      }),
    );

    $("export").addEventListener("click", () =>
      withBusy($("export"), async () => {
        const records = await fetchAllRecords();

        if (records) {
          downloadCsv(records);
        }
      }),
    );

    // Not withBusy: the pager decides which buttons are enabled for the new
    // page (e.g. Next is disabled on the last page), and withBusy would turn
    // the clicked button back on afterwards.
    const goToPage = async (page) => {
      prevButton.disabled = true;
      nextButton.disabled = true;
      showLoading();

      const res = await fetchReport(state.query, page);

      showReport(res);

      if (!res.ok) {
        renderPager(); // keep the current page's buttons as they were
      }
    };

    prevButton.addEventListener("click", () =>
      goToPage(state.pagination.page - 1),
    );
    nextButton.addEventListener("click", () =>
      goToPage(state.pagination.page + 1),
    );

    return {
      // Loads the filter options and the first page together, renders once
      open: async () => {
        showLoading();

        const [options, report] = await Promise.all([
          loadOptions(),
          fetchReport(state.query),
        ]);

        applyOptions(options);
        showReport(report);
      },
    };
  };
})();
</file>

<file path="frontend/js/sessions.js">
// Admin: schedule view. Postpone or cancel a class day, schedule / reschedule /
// cancel a replacement, and undo postponements and cancellations.
// The server decides which actions each row allows (entry.actions); this file
// only shows them and sends the right request.
// Needs: common.js (NIIT helpers) loaded first.
document.addEventListener("DOMContentLoaded", () => {
  if (!document.getElementById("sessionsContainer")) {
    return;
  }

  const {
    api,
    showToast,
    withBusy,
    el,
    showPanel,
    makeCell,
    emptyRow,
    loadingRow,
    errorRow,
    formatDate,
    getClasses,
    fillSelect,
  } = NIIT;
  const byId = (id) => document.getElementById(id);

  // ---------- DOM ----------
  const openButton = byId("manageSessionsButton");
  const fromInput = byId("sessionFrom");
  const toInput = byId("sessionTo");
  const classFilter = byId("sessionClassFilter");
  const loadButton = byId("loadSessionsButton");
  const tableBody = byId("sessionsTableBody");

  const dialog = byId("sessionDialog");
  const dialogForm = byId("sessionDialogForm");
  const dialogTitle = byId("sessionDialogTitle");
  const dialogSummary = byId("sessionDialogSummary");
  const dialogError = byId("sessionDialogError");
  const dialogCancel = byId("sessionDialogCancel");
  const dialogConfirm = byId("sessionDialogConfirm");
  const reasonGroup = byId("sessionReasonGroup");
  const reasonInput = byId("sessionReason");
  const replacementRow = byId("scheduleReplacementRow");
  const replacementToggle = byId("scheduleReplacement");
  const replacementFields = byId("replacementFields");
  const replacementDate = byId("replacementDate");
  const replacementStart = byId("replacementStart");
  const replacementEnd = byId("replacementEnd");

  // ---------- State ----------
  const state = { entries: [], today: "", pending: null, opened: false };

  // ---------- Dates ----------
  const DAY_MS = 24 * 60 * 60 * 1000;

  const todayLagos = () =>
    new Intl.DateTimeFormat("en-CA", { timeZone: "Africa/Lagos" }).format(
      new Date(),
    );

  const addDays = (key, days) =>
    new Date(new Date(`${key}T00:00:00.000Z`).getTime() + days * DAY_MS)
      .toISOString()
      .slice(0, 10);

  const weekday = (key) =>
    new Date(`${key}T00:00:00.000Z`).toLocaleDateString("en-GB", {
      timeZone: "UTC",
      weekday: "short",
    });

  const slot = (item) => `${item.startTime}\u00a0\u2013\u00a0${item.endTime}`;

  const laterOf = (a, b) => (a > b ? a : b);

  // ---------- What each action looks like ----------
  // replacement: "optional" shows a checkbox, "required" always asks for it
  const ACTIONS = {
    postpone: {
      label: "Postpone",
      title: "Postpone session",
      confirm: "Postpone",
      reason: true,
      replacement: "optional",
      warning:
        "Attendance already recorded for this session will be marked invalid.",
    },
    cancel: {
      label: "Cancel class",
      title: "Cancel session",
      confirm: "Cancel session",
      reason: true,
      danger: true,
      warning:
        "Attendance already recorded for this session will be marked invalid.",
    },
    add_replacement: {
      label: "Add replacement",
      title: "Schedule a replacement session",
      confirm: "Schedule",
      reason: false,
      replacement: "required",
    },
    reschedule: {
      label: "Reschedule",
      title: "Reschedule replacement session",
      confirm: "Reschedule",
      reason: true,
      replacement: "required",
      warning: "Any attendance already recorded for it will be deleted.",
    },
    cancel_replacement: {
      label: "Cancel replacement",
      title: "Cancel replacement session",
      confirm: "Cancel replacement",
      reason: true,
      danger: true,
      warning:
        "The original session stays postponed, with no replacement scheduled.",
    },
    undo_postponement: {
      label: "Undo postponement",
      ask: "Undo this postponement? Its replacement session (if any) will be removed.",
    },
    undo_cancellation: {
      label: "Undo cancellation",
      ask: "Undo this cancellation and restore the session?",
    },
  };

  // ---------- Requests ----------
  // Turns an action + row + form values into the API call. Days that have no
  // session record yet are addressed by timetable + date ("occurrence").
  const requestFor = (action, entry, values = {}) => {
    const reason = values.reason || undefined;
    const replacement = values.withReplacement
      ? {
          replacementDate: values.date,
          replacementStartTime: values.start,
          replacementEndTime: values.end,
        }
      : {};

    switch (action) {
      case "postpone":
        return entry.id
          ? {
              path: `/sessions/${entry.id}/postpone`,
              body: { reason, ...replacement },
            }
          : {
              path: "/sessions/postpone-occurrence",
              body: {
                timetable: entry.timetable,
                date: entry.date,
                reason,
                ...replacement,
              },
            };

      case "cancel":
        return entry.id
          ? { path: `/sessions/${entry.id}/cancel`, body: { reason } }
          : {
              path: "/sessions/cancel-occurrence",
              body: { timetable: entry.timetable, date: entry.date, reason },
            };

      // A postponed original gets its replacement; a replacement row is
      // itself rescheduled. Both go through the postpone endpoint.
      case "add_replacement":
      case "reschedule":
        return {
          path: `/sessions/${entry.id}/postpone`,
          body: { reason, ...replacement },
        };

      case "cancel_replacement":
        return {
          path: `/sessions/${entry.id}/cancel-replacement`,
          body: { reason },
        };

      case "undo_postponement":
        return { path: `/sessions/${entry.id}/undo-postponement`, body: {} };

      case "undo_cancellation":
        return { path: `/sessions/${entry.id}/undo-cancellation`, body: {} };

      default:
        throw new Error(`Unknown action: ${action}`);
    }
  };

  const send = (request) =>
    api(request.path, { method: "PATCH", body: request.body });

  // ---------- Table ----------
  const detailLines = (entry) => {
    const lines = [];

    if (entry.reason) {
      lines.push(`Reason: ${entry.reason}`);
    }

    if (entry.replacement) {
      lines.push(
        `Moved to ${weekday(entry.replacement.date)} ${formatDate(entry.replacement.date)}, ${entry.replacement.startTime}\u00a0\u2013\u00a0${entry.replacement.endTime}`,
      );
    } else if (entry.status === "postponed") {
      lines.push("No replacement scheduled yet");
    }

    if (entry.original) {
      lines.push(
        `Replaces ${weekday(entry.original.date)} ${formatDate(entry.original.date)}, ${entry.original.startTime}\u00a0\u2013\u00a0${entry.original.endTime}`,
      );
    }

    return lines;
  };

  const actionButton = (action, entry) => {
    const button = el("button", {
      type: "button",
      text: ACTIONS[action].label,
      className: ACTIONS[action].danger ? "btn-danger-outline" : undefined,
    });

    button.addEventListener("click", () =>
      withBusy(button, async () => {
        if (ACTIONS[action].ask) {
          await runDirect(action, entry);
        } else {
          openDialog(action, entry);
        }
      }),
    );

    return button;
  };

  const renderRows = () => {
    tableBody.replaceChildren();

    if (!state.entries.length) {
      tableBody.appendChild(
        emptyRow(
          7,
          "No classes in this period. Check the dates, and that active timetables cover them.",
        ),
      );
      return;
    }

    state.entries.forEach((entry) => {
      const row = el("tr", {
        className:
          [
            entry.isReplacement ? "replacement" : "",
            entry.date === state.today ? "today" : "",
          ]
            .join(" ")
            .trim() || undefined,
      });

      const dateCell = makeCell(
        el(
          "span",
          {},
          `${weekday(entry.date)} ${formatDate(entry.date)}`,
          entry.date === state.today
            ? el("span", { className: "badge badge-role", text: "Today" })
            : null,
        ),
      );

      const courseCell = makeCell(
        el(
          "span",
          {},
          entry.course,
          entry.isReplacement
            ? el("span", {
                className: "badge badge-muted",
                text: "Replacement",
              })
            : null,
        ),
      );

      const actionsCell = makeCell("");

      entry.actions.forEach((action) =>
        actionsCell.appendChild(actionButton(action, entry)),
      );

      row.append(
        dateCell,
        makeCell(slot(entry)),
        courseCell,
        makeCell((entry.class && entry.class.name) || "Unassigned"),
        makeCell((entry.instructor && entry.instructor.name) || "N/A"),
        makeCell(entry.status),
        actionsCell,
      );

      tableBody.appendChild(row);
    });
  };

  // ---------- Data ----------
  const load = async () => {
    const params = new URLSearchParams();

    if (fromInput.value) {
      params.set("from", fromInput.value);
    }

    if (toInput.value) {
      params.set("to", toInput.value);
    }

    if (classFilter.value) {
      params.set("class", classFilter.value);
    }

    tableBody.replaceChildren(loadingRow(7));

    const res = await api(`/sessions/schedule?${params}`);

    if (!res.ok) {
      const message = res.data.message || "Could not load sessions";

      showToast(message, "error");
      tableBody.replaceChildren(errorRow(7, message));
      return;
    }

    state.entries = res.data.sessions || [];
    state.today = res.data.today || "";

    renderRows();
  };

  const loadFilterClasses = async () => {
    const { classes, error } = await getClasses();

    if (error) {
      showToast(error, "error");
    }

    fillSelect(classFilter, classes, {
      placeholder: "All classes",
      selected: classFilter.value,
    });
  };

  // ---------- Undo (no form needed) ----------
  const runDirect = async (action, entry) => {
    if (!window.confirm(ACTIONS[action].ask)) {
      return;
    }

    const res = await send(requestFor(action, entry));

    showToast(
      res.data.message || (res.ok ? "Done" : "Request failed"),
      res.ok ? "success" : "error",
    );

    if (res.ok) {
      await load();
    }
  };

  // ---------- Dialog ----------
  const showDialog = () =>
    typeof dialog.showModal === "function"
      ? dialog.showModal()
      : dialog.setAttribute("open", "");

  const closeDialog = () => {
    if (typeof dialog.close === "function") {
      dialog.close();
    } else {
      dialog.removeAttribute("open");
    }

    state.pending = null;
  };

  const syncReplacementFields = () => {
    const config = ACTIONS[state.pending.action];
    const needed =
      config.replacement === "required" ||
      (config.replacement === "optional" && replacementToggle.checked);

    replacementFields.hidden = !needed;
  };

  const openDialog = (action, entry) => {
    const config = ACTIONS[action];

    state.pending = { action, entry };

    dialogTitle.textContent = config.title;
    dialogSummary.replaceChildren(
      ...[
        el("div", {
          text: `${entry.course} \u00b7 ${(entry.class && entry.class.name) || "No class"} \u00b7 ${weekday(entry.date)} ${formatDate(entry.date)}, ${slot(entry)}`,
        }),
        config.warning
          ? el("div", { className: "dialog-warning", text: config.warning })
          : null,
      ].filter(Boolean),
    );

    dialogError.textContent = "";
    reasonInput.value = "";
    reasonGroup.hidden = !config.reason;

    replacementRow.hidden = config.replacement !== "optional";
    replacementToggle.checked = true;

    // A replacement can't be earlier than today or than the original session
    const earliest = laterOf(
      state.today,
      entry.original ? entry.original.date : entry.date,
    );

    replacementDate.min = earliest;
    replacementDate.value = action === "reschedule" ? entry.date : "";
    replacementStart.value = entry.startTime;
    replacementEnd.value = entry.endTime;

    dialogConfirm.textContent = config.confirm;
    dialogConfirm.classList.toggle("btn-danger", Boolean(config.danger));

    syncReplacementFields();
    showDialog();
  };

  // Returns { values } or { error }
  const readDialog = () => {
    const { action, entry } = state.pending;
    const config = ACTIONS[action];
    const withReplacement =
      config.replacement === "required" ||
      (config.replacement === "optional" && replacementToggle.checked);

    const values = {
      reason: config.reason ? reasonInput.value.trim() : "",
      withReplacement,
      date: replacementDate.value,
      start: replacementStart.value,
      end: replacementEnd.value,
    };

    if (!withReplacement) {
      return { values };
    }

    if (!values.date || !values.start || !values.end) {
      return { error: "Enter the replacement date, start time and end time." };
    }

    if (values.end <= values.start) {
      return { error: "The end time must be after the start time." };
    }

    if (new Date(`${values.date}T${values.start}:00+01:00`) <= new Date()) {
      return { error: "The replacement must be scheduled for a future time." };
    }

    const earliest = laterOf(
      state.today,
      entry.original ? entry.original.date : entry.date,
    );

    if (values.date < earliest) {
      return {
        error: "The replacement can't be before the original session.",
      };
    }

    return { values };
  };

  const submitDialog = async (event) => {
    event.preventDefault();

    if (!state.pending) {
      return;
    }

    const { values, error } = readDialog();

    if (error) {
      dialogError.textContent = error;
      return;
    }

    dialogError.textContent = "";

    await withBusy(dialogConfirm, async () => {
      const { action, entry } = state.pending;
      const res = await send(requestFor(action, entry, values));

      if (!res.ok) {
        // The toast would sit behind the open dialog, so show the error here
        dialogError.textContent = res.data.message || "Request failed";
        return;
      }

      closeDialog();
      showToast(res.data.message || "Done");
      await load();
    });
  };

  // ---------- Wire up ----------
  openButton.addEventListener("click", async () => {
    showPanel("sessionsContainer", openButton);

    if (!state.opened) {
      state.opened = true;
      fromInput.value = fromInput.value || todayLagos();
      toInput.value = toInput.value || addDays(fromInput.value, 13);
    }

    await Promise.all([loadFilterClasses(), load()]);
  });

  loadButton.addEventListener("click", () => withBusy(loadButton, load));
  classFilter.addEventListener("change", load);

  replacementToggle.addEventListener("change", () => {
    if (state.pending) {
      syncReplacementFields();
    }
  });

  dialogForm.addEventListener("submit", submitDialog);
  dialogCancel.addEventListener("click", closeDialog);
  dialog.addEventListener("close", () => {
    state.pending = null;
  });
});
</file>

<file path="frontend/js/student.js">
// Student dashboard: current session (check in / out), summary numbers and
// the student's own attendance history with course / date filters.
// Needs: common.js (NIIT helpers) loaded first.
document.addEventListener("DOMContentLoaded", () => {
  const {
    api,
    showToast,
    withBusy,
    el,
    createAutocomplete,
    getUser,
    formatClock,
    buildAttendanceRow,
    emptyRow,
    loadingRow,
    errorRow,
    makeCell,
  } = NIIT;
  const byId = (id) => document.getElementById(id);

  // The student section is in the page for every role, so check who is signed in
  const user = getUser();

  if (!byId("studentDashboard") || !user || user.role !== "student") {
    return;
  }

  const REPORT_PATH = "/reports/student/attendance";
  const SUMMARY_PATH = "/reports/student/summary";
  const TARGET_RATE = 75; // rate that gets a green badge; half of it amber
  const POLL_MS = 30000; // how often the session card refreshes itself

  // ---------- DOM ----------
  const dashboard = byId("studentDashboard");
  const sessionBox = byId("currentSession");
  const courseInput = byId("studentCourseFilter");
  const courseList = byId("studentCourseSuggestions");
  const dateInput = byId("studentDateFilter");
  const filterButton = byId("filterStudentAttendanceButton");
  const clearButton = byId("clearStudentAttendanceFiltersButton");
  const tableBody = byId("studentAttendanceTableBody");

  // The summary row isn't in the HTML; it is added under the page subtitle
  const summary = el("div", { id: "studentSummary", className: "stat-row" });
  dashboard.querySelector(".page-subtitle").after(summary);

  // Per-course breakdown, shown under the tiles when there is more than one
  const courseSummary = el("div", { id: "studentCourseSummary" });
  summary.after(courseSummary);

  // ---------- State ----------
  const state = {
    records: [], // all of this student's attendance records
    courses: [], // course names for the filter search box
    session: null, // today's active session, if any
    sessionError: "", // set when the session could not be loaded
    sessionRetry: true, // false when trying again can't help (e.g. no class yet)
    summary: null, // server-side totals, including sessions never attended
  };

  // ---------- Summary ----------
  // Comes from the server so it can count sessions the student never signed in
  // to (those have no attendance record to count on this side).
  const rateTone = (rate) => {
    if (rate >= TARGET_RATE) {
      return "success";
    }

    return rate >= TARGET_RATE / 2 ? "warn" : "danger";
  };

  const rateText = (rate) =>
    rate === null || rate === undefined ? "-" : `${rate}%`;

  const tile = (label, value, tone) =>
    el(
      "div",
      { className: `stat${tone ? ` stat-${tone}` : ""}` },
      el("div", { className: "stat-value", text: String(value) }),
      el("div", { className: "stat-label", text: label }),
    );

  const renderSummary = () => {
    const data = state.summary;

    if (!data) {
      summary.replaceChildren();
      courseSummary.replaceChildren();
      return;
    }

    summary.replaceChildren(
      tile(
        "Attendance rate",
        rateText(data.rate),
        data.rate === null ? "" : rateTone(data.rate),
      ),
      tile("Sessions held", data.held),
      tile("On time", data.present),
      tile("Late", data.late),
      tile("Absent", data.absent, data.absent ? "danger" : ""),
    );

    if (!data.byCourse || data.byCourse.length < 2) {
      courseSummary.replaceChildren();
      return;
    }

    const body = document.createElement("tbody");

    data.byCourse.forEach((course) => {
      const row = document.createElement("tr");

      row.append(
        makeCell(course.course),
        makeCell(String(course.held)),
        makeCell(String(course.present)),
        makeCell(String(course.late)),
        makeCell(String(course.absent)),
        makeCell(
          course.rate === null
            ? "-"
            : el("span", {
                className: `badge badge-${rateTone(course.rate)}`,
                text: `${course.rate}%`,
              }),
        ),
      );

      body.appendChild(row);
    });

    const head = document.createElement("thead");
    const headRow = document.createElement("tr");

    ["Course", "Held", "On time", "Late", "Absent", "Rate"].forEach((label) =>
      headRow.appendChild(el("th", { scope: "col", text: label })),
    );
    head.appendChild(headRow);

    courseSummary.replaceChildren(
      el("h3", { text: "By course" }),
      el(
        "div",
        { className: "table-scroll" },
        el("table", { className: "report-table" }, head, body),
      ),
    );
  };

  // ---------- Current session ----------
  // Session dates are stored as the Lagos calendar day, times as "HH:mm" (WAT, UTC+1)
  const sessionWindow = (session) => {
    const day = String(session.date).slice(0, 10);

    return {
      start: new Date(`${day}T${session.startTime}:00+01:00`),
      end: new Date(`${day}T${session.endTime}:00+01:00`),
    };
  };

  // Works out what the card should say and which buttons are usable.
  // This is only a hint for the UI: the server decides what is really allowed.
  const describeSession = (session, record) => {
    const { start, end } = sessionWindow(session);
    const now = new Date();

    if (!record) {
      if (now < start) {
        return {
          label: "Not started",
          tone: "muted",
          note: `Check-in opens at ${session.startTime}.`,
        };
      }

      if (now > end) {
        return {
          label: "Ended",
          tone: "danger",
          note: "This session has ended.",
        };
      }

      return {
        label: "Not checked in",
        tone: "warn",
        note: "Check in now to be marked present.",
        canCheckIn: true,
      };
    }

    if (!record.isValid) {
      return {
        label: "Invalidated",
        tone: "danger",
        note:
          record.invalidationReason ||
          "Your attendance for this session was invalidated.",
      };
    }

    if (record.signOut) {
      const outcome =
        record.classAttended === true
          ? "Counted as attended."
          : "Not enough time in class to count as attended.";

      return {
        label: "Checked out",
        tone: "success",
        note: `Signed out at ${formatClock(record.signOut)}. ${outcome}`,
      };
    }

    return {
      label: "Checked in",
      tone: "success",
      note:
        `Signed in at ${formatClock(record.signIn)}` +
        `${record.status === "late" ? " (late)" : ""}. ` +
        "Remember to check out before you leave.",
      canCheckOut: true,
    };
  };

  const act = async (action, sessionId) => {
    const res = await api(`/attendance/${action}`, {
      method: "POST",
      body: { sessionId },
    });

    showToast(
      res.data.message || (res.ok ? "Done" : "Request failed"),
      res.ok ? "success" : "error",
    );

    if (res.ok) {
      await refresh({ table: true });
    }
  };

  const renderSession = () => {
    sessionBox.replaceChildren();

    if (state.sessionError) {
      sessionBox.append(
        el("p", { className: "session-empty", text: state.sessionError }),
        ...(state.sessionRetry
          ? [
              el("button", {
                type: "button",
                className: "btn-outline",
                text: "Try again",
                onClick: () => refresh(),
              }),
            ]
          : []),
      );
      return;
    }

    const session = state.session;

    if (!session) {
      sessionBox.append(
        el("p", {
          className: "session-empty",
          text: "No class is in session right now.",
        }),
      );
      return;
    }

    const record = state.records.find(
      (item) => item.session && item.session._id === session._id,
    );
    const info = describeSession(session, record);

    const checkInButton = el("button", {
      type: "button",
      text: "Check in",
      disabled: !info.canCheckIn,
    });

    const checkOutButton = el("button", {
      type: "button",
      className: "btn-outline",
      text: "Check out",
      disabled: !info.canCheckOut,
    });

    checkInButton.addEventListener("click", () =>
      withBusy(checkInButton, () => act("check-in", session._id)),
    );

    checkOutButton.addEventListener("click", () =>
      withBusy(checkOutButton, async () => {
        const sure = window.confirm(
          "Check out now? You won't be able to check in again for this session.",
        );

        if (sure) {
          await act("check-out", session._id);
        }
      }),
    );

    sessionBox.append(
      el(
        "div",
        { className: "session-card" },
        el(
          "div",
          { className: "session-main" },
          el("div", { className: "session-title", text: session.course }),
          el("div", {
            className: "session-meta",
            text: `${session.startTime} \u2013 ${session.endTime}`,
          }),
          el("div", { className: "session-note", text: info.note }),
        ),
        el(
          "div",
          { className: "session-state" },
          el("span", {
            className: `badge badge-${info.tone}`,
            text: info.label,
          }),
          record && record.isValid && record.status === "late"
            ? el("span", { className: "badge badge-warn", text: "Late" })
            : null,
        ),
        el(
          "div",
          { className: "session-actions" },
          checkInButton,
          checkOutButton,
        ),
      ),
    );
  };

  // ---------- History table ----------
  const renderAttendance = (records = []) => {
    tableBody.replaceChildren();

    if (!records.length) {
      tableBody.appendChild(emptyRow(9, "No attendance records found."));
      return;
    }

    records.forEach((record) =>
      tableBody.appendChild(buildAttendanceRow(record)),
    );
  };

  const clearFilters = () => {
    courseInput.value = "";
    dateInput.value = "";
    courseList.innerHTML = "";
  };

  // ---------- Data ----------
  // Loads the session and the records together. Pass { table: true } to also
  // reset the filters and redraw the history table.
  const refresh = async ({ table = false } = {}) => {
    const [sessionRes, recordsRes, summaryRes] = await Promise.all([
      api("/sessions/current"),
      api(REPORT_PATH),
      table ? api(SUMMARY_PATH) : null,
    ]);

    if (recordsRes.ok) {
      state.records = recordsRes.data.attendance || [];
      state.courses = [
        ...new Set(
          state.records
            .map((record) => record.session && record.session.course)
            .filter(Boolean),
        ),
      ];

      if (table) {
        clearFilters();
        renderAttendance(state.records);
      }
    } else if (table) {
      const message =
        recordsRes.data.message || "Could not load your attendance";

      showToast(message, "error");
      tableBody.replaceChildren(errorRow(9, message));
    }

    // The totals only change after a check-in / check-out, so they are fetched
    // with the table and not on every 30-second poll
    if (summaryRes && summaryRes.ok) {
      state.summary = summaryRes.data.summary;
      renderSummary();
    }

    if (sessionRes.ok) {
      state.session = sessionRes.data.session || null;
      state.sessionError = "";
    } else if (sessionRes.status === 404) {
      // The API answers 404 when nothing is running: not an error
      state.session = null;
      state.sessionError = "";
    } else {
      state.session = null;
      state.sessionError =
        sessionRes.data.message || "Could not load the current session.";
      // 403 = no class assigned: waiting or retrying won't change that
      state.sessionRetry = sessionRes.status !== 403;
    }

    renderSession();
  };

  // ---------- Filters ----------
  // The API filters by course OR date, so using one clears the other.
  createAutocomplete({
    input: courseInput,
    list: courseList,
    getItems: () => state.courses,
    onType: () => {
      dateInput.value = "";
    },
  });

  dateInput.addEventListener("change", () => {
    courseInput.value = "";
    courseList.innerHTML = "";
  });

  const applyFilter = async () => {
    const course = courseInput.value.trim();
    const date = dateInput.value;

    if (!course && !date) {
      showToast("Pick a course or a date to filter by", "error");
      return;
    }

    if (course && date) {
      showToast("Please use only one filter at a time", "error");
      return;
    }

    const path = course
      ? `${REPORT_PATH}/course/${encodeURIComponent(course)}`
      : `${REPORT_PATH}/date/${encodeURIComponent(date)}`;

    const res = await api(path);

    if (!res.ok) {
      showToast(res.data.message || "Could not load attendance", "error");
      return;
    }

    renderAttendance(res.data.attendance);
  };

  // ---------- Wire up ----------
  filterButton.addEventListener("click", () =>
    withBusy(filterButton, applyFilter),
  );

  clearButton.addEventListener("click", () =>
    withBusy(clearButton, async () => {
      clearFilters();
      renderAttendance(state.records);
    }),
  );

  tableBody.replaceChildren(loadingRow(9));
  refresh({ table: true });

  // Keep the card honest while the page stays open (class starts, auto sign-out...)
  setInterval(() => {
    if (!document.hidden) {
      refresh();
    }
  }, POLL_MS);
});
</file>

